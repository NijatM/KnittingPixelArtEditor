{
  "name": "knitting-pixel-art-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/copy-runtimes.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-runtimes.mjs && node scripts/taxonomy-check.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "taxonomy:demo": "node scripts/taxonomy-demo.mjs",
    "taxonomy:check": "node scripts/taxonomy-check.mjs",
    "taxonomy:models": "rolldown scripts/taxonomy-models.ts --file node_modules/.cache/taxonomy-models.mjs --format esm --platform node && node node_modules/.cache/taxonomy-models.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.1.0",
    "onnxruntime-web": "^1.30.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.74",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
