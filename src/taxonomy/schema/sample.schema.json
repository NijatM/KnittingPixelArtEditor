{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sample.schema.json",
  "title": "SAMPLE",
  "description": "One knitted sample in a frame. Extends the material_bank v0.2 SAMPLE entity (sample_id, sample_name, sample_date, embedded sample_yarn) with status, structure, machine settings and performance values. Our own file, following the material_bank v0.2 conventions (Tailored Materiality Group). Checked beyond the schema: yarns exist and appear once, at least one main yarn, structure, roles, property ids, units and methods come from src/taxonomy/vocab, and a demo record has only generated values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sample_id", "sample_name", "sample_date", "data_as_of", "status", "sample_yarn", "structure"],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "sample_id": { "type": "string", "pattern": "^SMP_\\d{4}$" },
    "sample_name": { "type": "string", "minLength": 1 },
    "sample_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The day it was knitted." },
    "data_as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The day the record was last changed." },
    "status": { "enum": ["demo", "draft", "reviewed", "final"], "description": "vocab/record_status.json" },
    "sample_yarn": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["yarn_id", "yarn_role"],
        "properties": {
          "yarn_id": { "type": "string", "pattern": "^YRN_\\d{4}$" },
          "yarn_role": { "type": "string", "description": "vocab/yarn_role.json" }
        }
      }
    },
    "structure": { "type": "string", "description": "vocab/structure.json" },
    "pattern": { "type": "string", "description": "A Knit Grammar structure id, when this sample's own program differs from the structure's." },
    "photo": { "type": "string", "description": "Path of a photo of this sample, when there is one." },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "description": "vocab/machine.json",
      "properties": {
        "status": { "enum": ["measured", "generated"] },
        "machine_type": { "type": "string", "minLength": 1 },
        "gauge": { "type": "number", "exclusiveMinimum": 0 },
        "loop_length": { "type": "number", "exclusiveMinimum": 0 },
        "carriage_speed": { "type": "number", "exclusiveMinimum": 0 },
        "needles": { "type": "integer", "minimum": 1 },
        "courses": { "type": "integer", "minimum": 1 },
        "program": { "type": "string", "minLength": 1 }
      }
    },
    "performance": {
      "type": "object",
      "description": "Keyed by vocab/property.json ids.",
      "additionalProperties": { "$ref": "#/$defs/value" }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "method", "status"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "description": "Must equal the property's unit." },
        "method": { "type": "string", "description": "vocab/method.json" },
        "status": { "enum": ["measured", "estimated", "generated"], "description": "vocab/value_status.json" },
        "note": { "type": "string" }
      }
    }
  }
}
